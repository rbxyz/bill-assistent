{
  "name": "bill-assistant",
  "version": "0.2.0",
  "description": "Assistente pessoal de desktop — um mascote que passeia na parte inferior da tela e conversa via Azure OpenAI",
  "main": "./out/main/index.js",
  "author": "rbxyz",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "icon": "node scripts/generate-icon.mjs",
    "clean:release": "node -e \"require('fs').rmSync('release',{recursive:true,force:true})\"",
    "dist": "pnpm clean:release && electron-vite build && electron-builder --linux",
    "dist:win": "pnpm clean:release && electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "electron-vite": "^5.0.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.5"
  }
}
