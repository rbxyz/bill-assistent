# Credenciais da Azure OpenAI — copie este arquivo para .env e preencha
# Endpoint do recurso, ex.: https://meu-recurso.openai.azure.com
AZURE_OPENAI_ENDPOINT=
# Chave de API (Keys and Endpoint no portal Azure)
AZURE_OPENAI_API_KEY=
# Nome do DEPLOYMENT do modelo (não o nome do modelo), ex.: gpt-4o-mini
AZURE_OPENAI_DEPLOYMENT=
# Opcional — versão da API (padrão: 2024-10-21)
AZURE_OPENAI_API_VERSION=
